# 注：以下修改后必须重启生效
# AdGuardHome DNS 重定向端口
redir_port=31587

# SNI 深度嗅探防 HTTPDNS 绕过 (0: 默认纯 DNS 轻量防火墙模式，零代理冲突；1: 开启 NFQUEUE 首包嗅探需配合 sni 版核心)
ENABLE_SNI=0

# SNI 队列端口
sni_ports="443,8443"

# 代理订阅链接（若使用Box/Clash模块，可在此填入订阅链接；留空则不修改代理配置）
PROXY_URL=""

# VPN 下 DNS 接管策略 (auto: 默认推荐，零耗电本地自动识别“一键回国 VPN”与“翻墙出国 VPN”；1: 始终强制接管；0: 始终放行)
VPN_DNS_TAKEOVER=auto

# 运行模式预设 (overseas: 默认海外模式；cn: 国内模式)
RUN_MODE=overseas
